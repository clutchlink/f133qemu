+static RISCVException read_th_mapbaddr(CPURISCVState *env, int csrno,
+                                       target_ulong *val)
+{
+    /*
+     * MAPBADDR is the SoC memory-map (DRAM) base address, hardwired by
+     * the vendor.  The Allwinner F133/D1 (sun20iw1) C906 maps DRAM at
+     * 0x40000000; OpenSBI (Allwinner fork) reads this CSR to learn the
+     * DRAM window ([mapbaddr, mapbaddr + size)) and plants boot flags
+     * inside it, so returning 0 here causes store faults on real code.
+     */
+    *val = 0x40000000;
+    return RISCV_EXCP_NONE;
+}
